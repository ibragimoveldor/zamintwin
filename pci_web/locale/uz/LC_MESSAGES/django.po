#, python-format
msgid ""
"Overall road condition is Good (PCI %(pci)s). Continue routine maintenance "
"and periodic monitoring."
msgstr ""
"Yo‘lning umumiy holati yaxshi (PCI %(pci)s). Joriy ta’mirlash va davriy "
"monitoringni davom ettiring."

#, python-format
msgid ""
"Overall road condition is Satisfactory (PCI %(pci)s). Schedule preventive "
"maintenance within 1-2 years to prevent further deterioration."
msgstr ""
"Yo‘lning umumiy holati qoniqarli (PCI %(pci)s). Holat yomonlashmasligi uchun"
" 1–2 yil ichida profilaktik ta’mirlashni rejalashtiring."

#, python-format
msgid ""
"Overall road condition is Fair (PCI %(pci)s). Crack sealing and localized "
"patching are recommended within 6-12 months."
msgstr ""
"Yo‘lning umumiy holati o‘rtacha (PCI %(pci)s). 6–12 oy ichida yoriqlarni "
"berkitish va mahalliy yamash tavsiya etiladi."

#, python-format
msgid ""
"Overall road condition is Poor (PCI %(pci)s). Rehabilitation is needed. "
"Consider asphalt overlay for the most affected sections."
msgstr ""
"Yo‘lning umumiy holati yomon (PCI %(pci)s). Qayta tiklash zarur. Eng ko‘p "
"zararlangan uchastkalarga yangi asfalt qatlami yotqizishni ko‘rib chiqing."

#, python-format
msgid ""
"Overall road condition is Very Poor to Failed (PCI %(pci)s). Major "
"rehabilitation or full reconstruction is urgently required."
msgstr ""
"Yo‘lning umumiy holati juda yomon yoki yaroqsiz (PCI %(pci)s). Zudlik bilan "
"kapital ta’mirlash yoki to‘liq rekonstruksiya talab etiladi."

#, python-format
msgid ""
"%(count)d pothole detected (%(density)s per km). Priority patching "
"recommended for all critical and high severity potholes."
msgid_plural ""
"%(count)d potholes detected (%(density)s per km). Priority patching "
"recommended for all critical and high severity potholes."
msgstr[0] ""
"%(count)d ta chuqurcha aniqlandi (har km ga %(density)s ta). Barcha kritik "
"va yuqori jiddiylikdagi chuqurchalarni birinchi navbatda yamash tavsiya "
"etiladi."

#, python-format
msgid ""
"%(count)d crack defect detected across the surveyed route. Crack sealing "
"should be applied to prevent water infiltration and further deterioration."
msgid_plural ""
"%(count)d crack defects detected across the surveyed route. Crack sealing "
"should be applied to prevent water infiltration and further deterioration."
msgstr[0] ""
"Tekshirilgan marshrut bo‘ylab %(count)d ta yoriq aniqlandi. Suv kirishi va "
"holat yomonlashuvining oldini olish uchun yoriqlarni berkitish lozim."

#, python-format
msgid ""
"%(count)d critical-severity defect requires immediate attention. It poses a "
"safety hazard and should be addressed within 30 days."
msgid_plural ""
"%(count)d critical-severity defects require immediate attention. These pose "
"safety hazards and should be addressed within 30 days."
msgstr[0] ""
"%(count)d ta kritik nuqson zudlik bilan e’tibor talab qiladi. Bunday "
"nuqsonlar xavfsizlikka tahdid soladi va 30 kun ichida bartaraf etilishi "
"kerak."

#, python-format
msgid ""
"%(count)d high-severity defect detected. Schedule repair within the next "
"maintenance cycle (60-90 days)."
msgid_plural ""
"%(count)d high-severity defects detected. Schedule repair within the next "
"maintenance cycle (60-90 days)."
msgstr[0] ""
"%(count)d ta yuqori jiddiylikdagi nuqson aniqlandi. Ta’mirni keyingi texnik "
"xizmat tsiklida (60–90 kun) rejalashtiring."

msgid ""
"Re-survey this road section in 3-6 months to track condition changes and "
"verify the effectiveness of any maintenance actions taken."
msgstr ""
"Holat o‘zgarishini kuzatish va bajarilgan ta’mir ishlari samaradorligini "
"tekshirish uchun ushbu uchastkani 3–6 oydan keyin qayta tekshiring."

